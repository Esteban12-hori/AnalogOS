# Copiar como .env y completar localmente. Nunca versionar secretos.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
ANALOGOS_DATA_DIR=./data
ANALOGOS_ARTIFACT_DIR=./artifacts

# M8 (ADR-009): optional AI assistance, SERVER-ONLY. Never with the VITE_ prefix.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: additional exact origins (comma-separated) and provider timeout in ms (1000–55000).
ANALOGOS_AI_ALLOWED_ORIGINS=
ANALOGOS_AI_TIMEOUT_MS=20000
