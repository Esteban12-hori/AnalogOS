{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://analogos.cl/schemas/mission-evaluation.schema.json",
  "title": "AnalogOS Mission Evaluation (M8)",
  "description": "Deterministic result of applying the confirmed requirements to the v3 snapshot windows. It contains no new suitability percentage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["evaluation_version", "rules_version", "snapshot_version", "profile", "request_fingerprint", "outcome", "resolution", "comparability", "ordering_rule", "options", "recommended_site_ids", "none_prioritized", "pending_requirements", "open_questions", "data_request", "evidence", "limits"],
  "properties": {
    "evaluation_version": { "enum": ["1.0.0", "1.1.0"], "description": "Text version of the record: 1.0.0 = frozen Spanish wording (historical records), 1.1.0 = English wording. Logic, statuses, ranks, values, evidence and geometry do not depend on it (shared/mission/text)." },
    "rules_version": { "type": "string" },
    "snapshot_version": { "type": "string" },
    "profile": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "name", "status"],
      "properties": { "id": { "type": "string" }, "version": { "type": "string" }, "name": { "type": "string" }, "status": { "type": "string" } }
    },
    "request_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "outcome": { "enum": ["evaluated", "needs_window_selection", "insufficient_coverage", "unsupported_target"] },
    "resolution": { "$ref": "#/$defs/resolution" },
    "comparability": { "enum": ["full", "partial", "not_applicable"] },
    "ordering_rule": { "type": "string" },
    "options": { "type": "array", "items": { "$ref": "#/$defs/option" } },
    "recommended_site_ids": { "type": "array", "items": { "type": "string" } },
    "none_prioritized": { "type": "boolean" },
    "pending_requirements": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "data_request": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["acquisition_status", "requested_geometry", "requirements", "planned_sources", "note"],
          "properties": {
            "acquisition_status": { "const": "no_adquirido_en_M8" },
            "requested_geometry": { "$ref": "#/$defs/requested" },
            "requirements": { "type": "array", "items": { "type": "object" } },
            "planned_sources": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false, "required": ["dataset_id", "provider", "product", "landing_url"],
                "properties": { "dataset_id": { "type": "string" }, "provider": { "type": "string" }, "product": { "type": "string" }, "landing_url": { "type": "string" } }
              }
            },
            "note": { "type": "string" }
          }
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["evidence_id", "kind", "site_id", "dataset_id", "claim", "source_url"],
        "properties": {
          "evidence_id": { "type": "string" }, "kind": { "enum": ["artifact", "app_derived"] }, "site_id": { "type": "string" },
          "dataset_id": { "type": "string" }, "claim": { "type": "string" }, "source_url": { "type": ["string", "null"] }
        }
      }
    },
    "limits": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "$defs": {
    "bbox": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } },
    "requested": {
      "type": "object", "additionalProperties": false, "required": ["bbox", "point", "approx_area_km2"],
      "properties": {
        "bbox": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/bbox" }] },
        "point": { "oneOf": [{ "type": "null" }, { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }] },
        "approx_area_km2": { "type": ["number", "null"] }
      }
    },
    "resolution": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "state", "requested", "measured", "matches", "evaluated_site_ids", "notes"],
      "properties": {
        "mode": { "enum": ["catalog", "sector", "point", "bbox"] },
        "state": { "enum": ["covered", "window_selected", "needs_window_selection", "partial_coverage", "no_coverage"] },
        "requested": { "$ref": "#/$defs/requested" },
        "measured": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["site_id", "bbox", "area_km2"],
            "properties": { "site_id": { "type": "string" }, "bbox": { "$ref": "#/$defs/bbox" }, "area_km2": { "type": "number" } }
          }
        },
        "matches": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["site_id", "name", "relation", "request_covered_fraction", "window_covered_fraction"],
            "properties": {
              "site_id": { "type": "string" }, "name": { "type": "string" },
              "relation": { "enum": ["identical", "contains_point", "contains_bbox", "overlaps_bbox", "inside_bbox"] },
              "request_covered_fraction": { "type": ["number", "null"] }, "window_covered_fraction": { "type": ["number", "null"] }
            }
          }
        },
        "evaluated_site_ids": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["requirement_id", "label", "importance", "kind", "status", "required", "observed_value", "observed_unit", "reason", "evidence_ids", "scale_note", "period", "conversion"],
      "properties": {
        "requirement_id": { "type": "string" }, "label": { "type": "string" }, "importance": { "enum": ["critical", "preference"] },
        "kind": { "enum": ["measurable", "unmeasured"] }, "status": { "enum": ["cumple", "no_cumple", "no_evaluable"] },
        "required": { "type": "string" }, "observed_value": { "type": ["number", "string", "null"] }, "observed_unit": { "type": ["string", "null"] },
        "reason": { "type": "string" }, "evidence_ids": { "type": "array", "items": { "type": "string" } },
        "scale_note": { "type": ["string", "null"] }, "period": { "type": ["string", "null"] }, "conversion": { "type": ["string", "null"] }
      }
    },
    "option": {
      "type": "object", "additionalProperties": false,
      "required": ["site_id", "name", "country", "role", "status", "rank", "critical_failed", "critical_unknown", "preferences", "requirement_results", "snapshot_scores", "territorial_feasibility", "what_would_change", "field_checks", "limitations"],
      "properties": {
        "site_id": { "type": "string" }, "name": { "type": "string" }, "country": { "type": ["string", "null"] },
        "role": { "enum": ["candidate", "reference"] },
        "status": { "enum": ["priorizado_para_reconocimiento", "no_cumple_requisitos", "evidencia_insuficiente", "objetivo_no_soportado"] },
        "rank": { "type": ["integer", "null"], "minimum": 1 },
        "critical_failed": { "type": "array", "items": { "type": "string" } },
        "critical_unknown": { "type": "array", "items": { "type": "string" } },
        "preferences": {
          "type": "object", "additionalProperties": false, "required": ["met", "unmet", "unknown", "total"],
          "properties": { "met": { "type": "integer" }, "unmet": { "type": "integer" }, "unknown": { "type": "integer" }, "total": { "type": "integer" } }
        },
        "requirement_results": { "type": "array", "items": { "$ref": "#/$defs/result" } },
        "snapshot_scores": {
          "type": "object", "additionalProperties": false, "required": ["similarity", "confidence", "stability"],
          "properties": { "similarity": { "type": ["number", "null"] }, "confidence": { "type": "number" }, "stability": { "type": ["number", "null"] } }
        },
        "territorial_feasibility": { "const": "pending" },
        "what_would_change": { "type": "array", "items": { "type": "string" } },
        "field_checks": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
