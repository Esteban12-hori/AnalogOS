{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://analogos.cl/schemas/data-manifest.schema.json",
  "title": "AnalogOS Data Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_version", "created_at", "pipeline_version", "datasets"],
  "properties": {
    "snapshot_version": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "pipeline_version": {"type": "string"},
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dataset_id", "provider", "product", "collection_version", "landing_url", "access_url", "downloaded_at", "time_start", "time_end", "spatial_resolution", "temporal_resolution", "crs", "units", "license", "checksum", "nodata", "quality_notes", "transformations"],
        "properties": {
          "dataset_id": {"type": "string"},
          "provider": {"type": "string"},
          "product": {"type": "string"},
          "collection_version": {"type": "string"},
          "landing_url": {"type": "string", "format": "uri"},
          "access_url": {"type": "string", "format": "uri"},
          "downloaded_at": {"type": "string", "format": "date-time"},
          "time_start": {"type": ["string", "null"], "format": "date-time"},
          "time_end": {"type": ["string", "null"], "format": "date-time"},
          "spatial_resolution": {"type": "string"},
          "temporal_resolution": {"type": "string"},
          "crs": {"type": "string"},
          "units": {"type": "string"},
          "license": {"type": "string"},
          "checksum": {"type": "string"},
          "nodata": {"type": ["string", "number", "null"]},
          "quality_notes": {"type": "array", "items": {"type": "string"}},
          "transformations": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
