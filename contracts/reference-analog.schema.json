{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://analogos.cl/schemas/reference-analog.schema.json",
  "title": "AnalogOS · reference analogs (◆, to be calculated)",
  "description": "Catalog of emblematic analogs worldwide (config/reference_analogs.json). They have no similarity, confidence or ranking: the schema offers no place to put them (additionalProperties: false). Each analog requires an approximate location or region and at least one cited source; anything without a source is not published (docs/UX_REDESIGN.md §3.5, §7.2).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "analogs"],
  "properties": {
    "schema": {"const": "reference-analogs/1"},
    "analogs": {
      "type": "array",
      "maxItems": 24,
      "items": {"$ref": "#/$defs/analog"}
    }
  },
  "$defs": {
    "analog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "country", "status", "location", "sources"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 64},
        "name": {"type": "string", "minLength": 2, "maxLength": 80},
        "country": {"type": "string", "minLength": 2, "maxLength": 60},
        "status": {
          "description": "A reference analog is never scored in this snapshot.",
          "const": "por_calcular"
        },
        "location": {
          "oneOf": [
            {"$ref": "#/$defs/approximatePoint"},
            {"$ref": "#/$defs/region"}
          ]
        },
        "summary": {"type": "string", "maxLength": 280},
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/source"}
        }
      }
    },
    "approximatePoint": {
      "description": "Point cited by the source with its uncertainty radius: drawn as an “approximate area”, never as an exact pin.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "lon", "lat", "radius_km"],
      "properties": {
        "kind": {"const": "approximate_point"},
        "lon": {"type": "number", "minimum": -180, "maximum": 180},
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "radius_km": {"type": "number", "exclusiveMinimum": 0, "maximum": 500}
      }
    },
    "region": {
      "description": "Large region (for example, a whole desert) as a box [west, south, east, north] in WGS84 degrees.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "bbox"],
      "properties": {
        "kind": {"const": "region"},
        "bbox": {
          "type": "array",
          "prefixItems": [
            {"type": "number", "minimum": -180, "maximum": 180},
            {"type": "number", "minimum": -90, "maximum": 90},
            {"type": "number", "minimum": -180, "maximum": 180},
            {"type": "number", "minimum": -90, "maximum": 90}
          ],
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url"],
      "properties": {
        "title": {"type": "string", "minLength": 3, "maxLength": 200},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "publisher": {"type": "string", "maxLength": 120}
      }
    }
  }
}
